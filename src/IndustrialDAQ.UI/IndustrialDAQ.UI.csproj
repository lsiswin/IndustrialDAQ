<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\IndustrialDAQ.Core\IndustrialDAQ.Core.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Acquisition\IndustrialDAQ.Acquisition.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Alarm\IndustrialDAQ.Alarm.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Infrastructure\IndustrialDAQ.Infrastructure.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Processing\IndustrialDAQ.Processing.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Storage\IndustrialDAQ.Storage.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Trend\IndustrialDAQ.Trend.csproj" />
    <ProjectReference Include="..\IndustrialDAQ.Vision\IndustrialDAQ.Vision.csproj" />
    <ProjectReference Include="..\..\Plugins\Drivers.Modbus\Drivers.Modbus.csproj" />
    <ProjectReference Include="..\..\Plugins\Drivers.Mqtt\Drivers.Mqtt.csproj" />
    <ProjectReference Include="..\..\Plugins\Drivers.OpcUA\Drivers.OpcUA.csproj" />
    <ProjectReference Include="..\..\Plugins\Drivers.S7\Drivers.S7.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" Version="2.0.0-rc2" />
    <PackageReference Include="Prism.DryIoc" Version="9.0.537" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Settings.Designer.cs">
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="Properties\Settings.settings">
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.cs</LastGenOutput>
    </None>
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>False</UseWindowsForms>
    <StartupObject>IndustrialDAQ.UI.App</StartupObject>
  </PropertyGroup>

</Project>
