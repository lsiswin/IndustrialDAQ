<!-- File: SystemSettingsView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.SystemSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:views="clr-namespace:IndustrialDAQ.UI.Views"
             xmlns:converters="clr-namespace:IndustrialDAQ.UI.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:BooleanNegateConverter x:Key="BooleanNegate"/>
        <views:CategoryNameToVisibilityConverter x:Key="CategoryToVis"/>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ 左侧分类菜单 ═══ -->
        <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Margin="0,0,6,0">
            <StackPanel>
                <TextBlock Style="{StaticResource PanelTitleStyle}" Text="设置分类"/>

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="CategoryBorder"
                                    Padding="10,10" Margin="0,0,0,2"
                                    CornerRadius="4" Cursor="Hand"
                                    Background="Transparent"
                                    MouseLeftButtonDown="CategoryClicked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontSize="13"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Description}" FontSize="11"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ═══ 右侧设置表单 ═══ -->
        <Border Grid.Column="1" Style="{StaticResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource PanelTitleStyle}"
                           Text="{Binding SelectedCategory.Name}"/>

                <!-- 设置表单内容区 -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,4">

                        <!-- ═══ 界面设置（仅"设备管理"分类显示）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=设备管理}">
                            <StackPanel>
                                <TextBlock Text="🎨 界面外观" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="系统主题"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedTheme}"
                                              Height="28" Margin="0,4" Width="200" HorizontalAlignment="Left"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 数据库设置（仅"存储管理"分类显示）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=存储管理}">
                            <StackPanel>
                                <TextBlock Text="📁 多数据库配置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="启动数据库"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding DatabaseProfiles}"
                                              SelectedItem="{Binding StartupDatabaseProfile}" DisplayMemberPath="Name"
                                              Height="30" Margin="0,4"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="数据保留天数"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding HistoryRetentionDays}" Height="28" Margin="0,4"
                                             Foreground="{StaticResource PanelBgBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="当前连接"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DatabasePath}"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6"
                                               TextWrapping="Wrap"/>
                                </Grid>

                                <DataGrid ItemsSource="{Binding DatabaseProfiles}" SelectedItem="{Binding SelectedDatabaseProfile}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" Height="220" Margin="0,10,0,6"
                                          IsReadOnly="{Binding CanModify, Converter={StaticResource BooleanNegate}}"
                                          HeadersVisibility="Column" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="名称" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="130"/>
                                        <DataGridTemplateColumn Header="类型" Width="100">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Provider}" VerticalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <ComboBox SelectedItem="{Binding Provider, UpdateSourceTrigger=PropertyChanged}"
                                                              ItemsSource="{Binding DataContext.AvailableDatabaseProviders, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="主机/SQLite 路径" Binding="{Binding Host, UpdateSourceTrigger=PropertyChanged}" Width="150"/>
                                        <DataGridTextColumn Header="端口" Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridTextColumn Header="数据库" Binding="{Binding Database, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                                        <DataGridTextColumn Header="用户名" Binding="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                                        <DataGridTextColumn Header="密码环境变量" Binding="{Binding PasswordEnvironmentVariable, UpdateSourceTrigger=PropertyChanged}" Width="190"/>
                                        <DataGridTextColumn Header="SQLite 路径" Binding="{Binding SqlitePath, UpdateSourceTrigger=PropertyChanged}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <StackPanel Orientation="Horizontal" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}">
                                    <Button Content="＋ 添加 PostgreSQL" Command="{Binding AddDatabaseCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="删除" Command="{Binding RemoveDatabaseCommand}" Padding="12,6" Margin="0,0,8,0"/>
                                    <Button Content="测试连接" Command="{Binding TestDatabaseCommand}" Padding="12,6"/>
                                </StackPanel>
                                <TextBlock Text="{Binding DatabaseStatus}" Foreground="{StaticResource TextDimBrush}"
                                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <TextBlock Text="密码不会写入配置；请填写保存密码的环境变量名称。保存并重启客户端后切换数据库。"
                                           Foreground="{StaticResource TextDimBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 采集参数（仅"系统参数"分类显示）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=系统参数}">
                            <StackPanel>
                                <TextBlock Text="⚙ 采集参数" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="超时时间 (ms)"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="0" Grid.Column="1"
                                             Text="{Binding AcquisitionTimeoutMs}" Height="28" Margin="0,4"
                                             Foreground="{StaticResource PanelBgBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="重试次数"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding RetryCount}" Height="28" Margin="0,4"
                                             Foreground="{StaticResource PanelBgBrush}"
                                             CaretBrush="{StaticResource TextPrimaryBrush}"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="死区压缩"
                                               Foreground="{StaticResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="0,4"/>
                                    <CheckBox Grid.Row="2" Grid.Column="1"
                                              IsChecked="{Binding EnableDeadband}"
                                              VerticalAlignment="Center" Margin="0,4"
                                              Foreground="{StaticResource TextSecondaryBrush}"
                                              Content="启用死区压缩以减少历史数据存储量"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 通信参数（仅"通信设置"分类显示）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=通信设置}">
                            <StackPanel>
                                <TextBlock Text="📡 通信参数" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <TextBlock Text="设备级 Modbus / OPC UA / MQTT 参数由设备配置 JSON 热加载；凭据仅通过环境变量注入。" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                                <TextBlock Text="{Binding NotificationConfiguration, StringFormat=报警外部通知：{0}}" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- ═══ 报警规则（仅"报警规则"分类显示 — 嵌入 AlarmRuleConfigView）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=报警规则}">
                            <!-- 显式绑定报警规则 ViewModel，防止嵌套视图误用系统设置命令。 -->
                            <views:AlarmRuleConfigView DataContext="{Binding AlarmRuleConfig}"/>
                        </Border>

                        <!-- ═══ 日志设置（仅"日志设置"分类显示）═══ -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=日志设置}">
                            <StackPanel>
                                <TextBlock Text="📋 日志设置" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal"><TextBlock Text="运行日志级别" Width="120"/><ComboBox ItemsSource="{Binding AvailableLogLevels}" SelectedItem="{Binding SelectedLogLevel}" Width="180"/></StackPanel>
                                <TextBlock Text="保存后立即调整 Serilog 最低输出级别。" Margin="0,8,0,0" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- 计算规则四步向导：输入、运算、输出、确认。 -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=计算规则}">
                            <Grid DataContext="{Binding CalculationRuleManagement}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,12">
                                    <TextBlock Text="∑ 计算规则向导" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="＋ 新增计算" Command="{Binding AddCommand}" Margin="0,0,6,0" Padding="12,6" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="删除" Command="{Binding DeleteCommand}" Margin="0,0,6,0" Padding="12,6" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}"/>
                                        <Button Content="刷新" Command="{Binding RefreshCommand}" Padding="12,6"/>
                                    </StackPanel>
                                </Grid>

                                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False"
                                          CanUserAddRows="False" IsReadOnly="True" Height="150" Margin="0,0,0,12">
                                    <DataGrid.Columns>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding Enabled}" Width="55"/>
                                        <DataGridTextColumn Header="输出名称" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="输入数据点" Binding="{Binding Inputs}" Width="2*"/>
                                        <DataGridTextColumn Header="公式" Binding="{Binding Formula}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <Border Background="{DynamicResource BrushBgTertiary}" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="① 选择第一个输入数据点" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding AvailableInputs}" SelectedItem="{Binding InputA}" DisplayMemberPath="DisplayText" Height="34"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushBgTertiary}" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="② 选择计算方式" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,6"/>
                                                <ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding Operation}" DisplayMemberPath="Name" Height="34"/>
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresInputB}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <TextBlock Text="第二个输入数据点 B" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <ComboBox ItemsSource="{Binding AvailableInputs}" SelectedItem="{Binding InputB}" DisplayMemberPath="DisplayText" Height="34"/>
                                                </StackPanel>
                                                <StackPanel Margin="0,8,0,0">
                                                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding RequiresFactor}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                                                    <TextBlock Text="系数（不能为 0）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                    <TextBox Text="{Binding Factor, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BrushBgTertiary}" CornerRadius="6" Padding="14" Margin="0,0,0,8">
                                            <StackPanel>
                                                <TextBlock Text="③ 给计算结果命名" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}" Margin="0,0,0,6"/>
                                                <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                                                <CheckBox Content="启用并参与实时计算" IsChecked="{Binding Enabled}" Margin="0,8,0,0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="6" Padding="14">
                                            <StackPanel>
                                                <TextBlock Text="④ 确认自动生成结果" FontWeight="SemiBold" Foreground="{DynamicResource InfoBrush}"/>
                                                <TextBlock Text="{Binding PreviewExpression, StringFormat=公式：{0}}" FontFamily="Consolas" FontSize="15" Margin="0,8,0,4" Foreground="{DynamicResource WarningBrush}"/>
                                                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,150,0"/>
                                    <Button Content="保存并立即生效" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Padding="18,8" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- 用户权限只通过系统设置维护，符合工业现场最小权限原则。 -->
                        <Border Style="{StaticResource CardBorderStyle}"
                                Visibility="{Binding SelectedCategory.Name, Converter={StaticResource CategoryToVis}, ConverterParameter=用户与权限}">
                            <Grid DataContext="{Binding UserAccessManagement}">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,10"><TextBlock Text="🔐 用户与权限管理中心" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Button Content="刷新" Command="{Binding RefreshCommand}" HorizontalAlignment="Right" Width="70"/></Grid>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" AutoGenerateColumns="False" Height="220" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="账号" Binding="{Binding Username}" IsReadOnly="True" Width="*"/>
                                        <DataGridTextColumn Header="姓名" Binding="{Binding RealName}" IsReadOnly="True" Width="*"/>
                                        <DataGridComboBoxColumn Header="角色" SelectedItemBinding="{Binding Role}" ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=DataGrid}}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsActive}" Width="70"/>
                                        <DataGridTextColumn Header="创建时间" Binding="{Binding CreatedAtUtc, StringFormat=yyyy-MM-dd HH:mm}" IsReadOnly="True" Width="150"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <Grid Grid.Row="2" Margin="0,10,0,14"><TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/><Button Content="保存账号权限" Command="{Binding SaveCommand}" HorizontalAlignment="Right" Padding="16,7" Visibility="{Binding IsAdministrator, Converter={StaticResource BoolToVisibility}}"/></Grid>
                                <TextBlock Grid.Row="3" Text="操作审计日志（最近 200 条）" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                                <DataGrid Grid.Row="4" ItemsSource="{Binding Audits}" AutoGenerateColumns="False" MinHeight="240" IsReadOnly="True" CanUserAddRows="False">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="时间" Binding="{Binding OccurredAtUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="150"/>
                                        <DataGridTextColumn Header="账号" Binding="{Binding Username}" Width="100"/>
                                        <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="150"/>
                                        <DataGridTextColumn Header="资源路径" Binding="{Binding ResourcePath}" Width="2*"/>
                                        <DataGridTextColumn Header="结果" Binding="{Binding Success}" Width="65"/>
                                        <DataGridTextColumn Header="详情" Binding="{Binding Detail}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- 操作按钮和状态 -->
                <Border Grid.Row="2" Padding="0,10,0,0"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextMutedBrush}"/>

                        <Button Grid.Column="1" Content="↺ 重置"
                                Command="{Binding ResetCommand}" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}"
                                Width="80" Height="30" Margin="0,0,8,0"
                                Background="{StaticResource BrushBgTertiary}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                        <Button Grid.Column="2" Content="💾 保存"
                                Command="{Binding SaveCommand}" Visibility="{Binding CanModify, Converter={StaticResource BoolToVisibility}}"
                                Width="80" Height="30"
                                Background="{StaticResource SuccessBrush}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
