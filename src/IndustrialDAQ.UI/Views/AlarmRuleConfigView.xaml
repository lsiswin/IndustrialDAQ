<UserControl x:Class="IndustrialDAQ.UI.Views.AlarmRuleConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:IndustrialDAQ.Core.Models;assembly=IndustrialDAQ.Core"
             xmlns:converters="clr-namespace:IndustrialDAQ.UI.Converters"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="FormTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="FormComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>
        <!-- 自定义条件开启时，隐藏向导式运算符/阈值面板 -->
        <Style x:Key="GuidedConditionStyle" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseCustomCondition}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 自定义资源路径开启时，隐藏向导式资源选择面板 -->
        <Style x:Key="GuidedResourceStyle" TargetType="StackPanel">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UseCustomResourcePath}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="2.5*"/>
        </Grid.ColumnDefinitions>

        <!-- 左侧：规则列表 -->
        <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="报警规则列表" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0"/>
                    <Button Grid.Column="1" Content="新增规则" Command="{Binding CreateNewCommand}"
                            Background="Transparent" BorderBrush="{DynamicResource SuccessBrush}"
                            Foreground="{DynamicResource SuccessBrush}" Padding="12,6" Cursor="Hand"
                            BorderThickness="1" Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                          Background="Transparent" BorderThickness="0" RowBackground="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="规则 ID" Binding="{Binding RuleId}" Width="100"/>
                        <DataGridTextColumn Header="报警代码" Binding="{Binding AlarmCode}" Width="110"/>
                        <DataGridTextColumn Header="级别" Binding="{Binding Severity}" Width="70"/>
                        <DataGridTextColumn Header="条件表达式" Binding="{Binding ConditionExpression}" Width="*"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 右侧：统一编辑区 -->
        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" CornerRadius="8"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="报警规则配置" FontSize="18" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,10,0">
                        <!-- 基本信息 -->
                        <TextBlock Text="基本信息" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="规则 ID (RuleId)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding RuleId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="报警代码 (AlarmCode)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding AlarmCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="标题" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="报警级别" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding Severities}" SelectedItem="{Binding Severity}"
                                  Style="{StaticResource FormComboBoxStyle}" IsEditable="False"/>
                        <CheckBox Content="启用" IsChecked="{Binding IsEnabled}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <!-- 资源与数据点 -->
                        <TextBlock Text="资源与数据点" Style="{StaticResource SectionTitleStyle}"/>

                        <CheckBox Content="手动指定资源路径（高级）" IsChecked="{Binding UseCustomResourcePath}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <StackPanel Style="{StaticResource GuidedResourceStyle}">
                            <TextBlock Text="资源路径（设备/数据点）" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding ResourcePaths}" SelectedItem="{Binding SelectedResourcePath}"
                                      Style="{StaticResource FormComboBoxStyle}" IsEditable="False"/>
                            <TextBlock Text="数据点" Style="{StaticResource FormLabelStyle}" Margin="0,8,0,4"/>
                            <ComboBox ItemsSource="{Binding AvailableTagNames}" SelectedItem="{Binding SelectedTagName}"
                                      Style="{StaticResource FormComboBoxStyle}" IsEditable="False"/>
                        </StackPanel>

                        <StackPanel Visibility="{Binding UseCustomResourcePath, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="监控资源路径 (TargetResourcePath)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CustomTargetResourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                     ToolTip="例如: Factory/LineA/PLC1/Temp1"/>
                            <TextBlock Text="报警资源路径 (ResourcePath)" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CustomResourcePath, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"
                                     ToolTip="例如: Factory/LineA/PLC1/Temp1/Alarm/TEMP_HIGH"/>
                            <TextBlock Text="TagId" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding CustomTagId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <!-- 触发条件 -->
                        <TextBlock Text="触发条件" Style="{StaticResource SectionTitleStyle}"/>
                        <CheckBox Content="使用自定义条件表达式（高级）" IsChecked="{Binding UseCustomCondition}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

                        <StackPanel Style="{StaticResource GuidedConditionStyle}">
                            <TextBlock Text="比较方式" Style="{StaticResource FormLabelStyle}"/>
                            <ComboBox ItemsSource="{Binding Operators}" SelectedItem="{Binding SelectedOperator}"
                                      Style="{StaticResource FormComboBoxStyle}" IsEditable="False"/>
                            <TextBlock Text="阈值" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                            <TextBlock Text="死区（区间上限，仅区间条件需要）" Style="{StaticResource FormLabelStyle}"/>
                            <TextBox Text="{Binding Deadband, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        </StackPanel>

                        <TextBox Visibility="{Binding UseCustomCondition, Converter={StaticResource BoolToVis}}"
                                 Text="{Binding ConditionExpression, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}"
                                 ToolTip="例如: Value &gt; 80"/>

                        <!-- 报警属性 -->
                        <TextBlock Text="报警属性" Style="{StaticResource SectionTitleStyle}"/>
                        <TextBlock Text="延迟 (毫秒)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="迟滞/死区 (Hysteresis)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding Hysteresis, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="冷却时间 (秒)" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding CooldownSeconds, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormTextBoxStyle}"/>
                        <TextBlock Text="确认策略" Style="{StaticResource FormLabelStyle}"/>
                        <ComboBox ItemsSource="{Binding AckPolicies}" SelectedItem="{Binding AckPolicy}"
                                  Style="{StaticResource FormComboBoxStyle}" IsEditable="False"/>
                        <TextBlock Text="消息模板" Style="{StaticResource FormLabelStyle}"/>
                        <TextBox Text="{Binding MessageTemplate, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource FormTextBoxStyle}" Height="60" TextWrapping="Wrap"
                                 ToolTip="支持占位符: {Value}, {TagName}, {AlarmCode}"/>

                        <!-- 预览 -->
                        <TextBlock Text="预览" Style="{StaticResource SectionTitleStyle}"/>
                        <Border Background="{DynamicResource BrushBgTertiary}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="生成的条件表达式:" Foreground="{DynamicResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,8,4"/>
                                <TextBlock Text="{Binding PreviewExpression}" Foreground="{DynamicResource WarningBrush}"
                                           FontSize="15" FontWeight="Bold" FontFamily="Consolas"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource BrushBgTertiary}" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                            <TextBlock Text="{Binding PreviewSummary}" Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontSize="13" LineHeight="22"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- 操作按钮 -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}">
                    <Button Content="删除" Command="{Binding DeleteCommand}"
                            Background="{DynamicResource DangerBrush}" Foreground="White"
                            Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="应用并热重载" Command="{Binding ReloadEngineCommand}"
                            Background="{DynamicResource WarningBrush}" Foreground="White"
                            Padding="16,8" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="保存并生效" Command="{Binding SaveCommand}"
                            Background="{DynamicResource SuccessBrush}" Foreground="White"
                            Padding="24,8" BorderThickness="0" Cursor="Hand" FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
