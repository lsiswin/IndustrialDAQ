<UserControl x:Class="IndustrialDAQ.UI.Views.AlarmRuleConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="StepCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/>
            <Setter Property="CornerRadius" Value="7"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style x:Key="StepTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="Margin" Value="0,0,0,7"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="6">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.15*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1.85*"/></Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,10">
                    <TextBlock Text="报警规则" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <Button Content="＋ 新增报警" Command="{Binding CreateNewCommand}" HorizontalAlignment="Right" Padding="11,5"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}"/>
                </Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Rules}" SelectedItem="{Binding SelectedRule}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="名称" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="数据点" Binding="{Binding TagName}" Width="*"/>
                        <DataGridTextColumn Header="阈值" Binding="{Binding Threshold}" Width="70"/>
                        <DataGridCheckBoxColumn Header="启用" Binding="{Binding IsEnabled}" Width="50"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="报警规则向导" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="不用编写表达式，按顺序选择即可立即生效" Foreground="{DynamicResource TextDimBrush}" Margin="0,3,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,8,0">
                        <Border Style="{StaticResource StepCard}">
                            <StackPanel>
                                <TextBlock Text="① 选择设备或计算分组" Style="{StaticResource StepTitle}"/>
                                <ComboBox ItemsSource="{Binding ResourcePaths}" SelectedItem="{Binding SelectedResourcePath}" Height="34"/>
                                <TextBlock Text="选择具体数据点" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,4"/>
                                <ComboBox ItemsSource="{Binding AvailableTagNames}" SelectedItem="{Binding SelectedTagName}" Height="34"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StepCard}">
                            <StackPanel>
                                <TextBlock Text="② 设置触发条件" Style="{StaticResource StepTitle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <ComboBox ItemsSource="{Binding OperatorChoices}" DisplayMemberPath="Name" SelectedValuePath="Value"
                                              SelectedValue="{Binding SelectedOperator}" Height="34"/>
                                    <TextBox Grid.Column="2" Text="{Binding Threshold, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,0" VerticalContentAlignment="Center" ToolTip="报警阈值"/>
                                </Grid>
                                <TextBlock Text="系统会自动生成触发和恢复条件；迟滞等防抖参数在高级设置中调整。" Foreground="{DynamicResource TextDimBrush}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource StepCard}">
                            <StackPanel>
                                <TextBlock Text="③ 设置操作员看到的内容" Style="{StaticResource StepTitle}"/>
                                <TextBlock Text="报警标题" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,0" VerticalContentAlignment="Center"/>
                                <TextBlock Text="报警级别" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,4"/>
                                <ComboBox ItemsSource="{Binding SeverityChoices}" DisplayMemberPath="Name" SelectedValuePath="Value" SelectedValue="{Binding Severity}" Height="34"/>
                                <TextBlock Text="报警提示" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,9,0,4"/>
                                <TextBox Text="{Binding MessageTemplate, UpdateSourceTrigger=PropertyChanged}" Height="58" Padding="8" TextWrapping="Wrap" AcceptsReturn="True"/>
                                <CheckBox Content="启用这条报警" IsChecked="{Binding IsEnabled}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource InfoBrush}" BorderThickness="1" CornerRadius="7" Padding="14" Margin="0,0,0,9">
                            <StackPanel>
                                <TextBlock Text="④ 确认规则" Style="{StaticResource StepTitle}"/>
                                <TextBlock Text="{Binding PreviewExpression}" FontFamily="Consolas" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                                <TextBlock Text="{Binding PreviewSummary}" TextWrapping="Wrap" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="高级设置（一般无需修改）" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,8">
                            <StackPanel Margin="0,10,0,0">
                                <TextBlock Text="规则 ID"/><TextBox Text="{Binding RuleId}" IsReadOnly="True" Margin="0,3,0,8"/>
                                <TextBlock Text="报警代码"/><TextBox Text="{Binding AlarmCode, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="延迟 ms"/><TextBox Text="{Binding DelayMs}"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="迟滞"/><TextBox Text="{Binding Hysteresis}"/></StackPanel>
                                    <StackPanel Grid.Column="4"><TextBlock Text="冷却秒"/><TextBox Text="{Binding CooldownSeconds}"/></StackPanel>
                                </Grid>
                                <CheckBox Content="自定义条件表达式" IsChecked="{Binding UseCustomCondition}" Margin="0,10,0,4"/>
                                <TextBox Text="{Binding ConditionExpression}" Visibility="{Binding UseCustomCondition, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0"
                            Visibility="{Binding CanModify, Converter={StaticResource BoolToVis}}">
                    <Button Content="删除" Command="{Binding DeleteCommand}" Padding="14,7" Margin="0,0,8,0" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="保存并立即生效" Command="{Binding SaveCommand}" Padding="20,7"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
