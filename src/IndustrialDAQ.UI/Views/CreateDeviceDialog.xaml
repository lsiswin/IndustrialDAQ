<UserControl x:Class="IndustrialDAQ.UI.Views.CreateDeviceDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Width="420" Height="500"
             Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondaryBrush}"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,6"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderSecondaryBrush}"
            BorderThickness="1" CornerRadius="8" Margin="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.4" Direction="270" ShadowDepth="4"/>
        </Border.Effect>

        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid><TextBlock Text="生成设备配置" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/><Button Content="✕" Command="{Binding CancelCommand}" Width="30" Height="30" Padding="0" Margin="0" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" ToolTip="关闭"/></Grid>

            <!-- 设备名称 -->
            <TextBlock Grid.Row="1" Text="设备名称" Margin="0,0,0,4"/>
            <TextBox Grid.Row="2" Text="{Binding DeviceName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <!-- 驱动类型（只读） -->
            <TextBlock Grid.Row="3" Text="驱动类型" Margin="0,0,0,4"/>
            <TextBox Grid.Row="4" Text="{Binding DriverType}" IsReadOnly="True" Opacity="0.7" Margin="0,0,0,10"/>

            <!-- IP 地址 -->
            <TextBlock Grid.Row="5" Text="IP 地址" Margin="0,0,0,4"/>
            <TextBox Grid.Row="6" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10"/>

            <!-- 端口 / 采集周期 / 超时 / 重试 -->
            <Grid Grid.Row="7" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="端口号" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="采集周期 (ms)" Margin="4,0,0,4"/>
                <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,8"/>
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CycleTimeMs, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,8"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="超时时间 (ms)" Margin="0,0,4,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="重试次数" Margin="4,0,0,4"/>
                <TextBox Grid.Row="3" Grid.Column="0" Text="{Binding TimeoutMs, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,4,0"/>
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RetryCount, UpdateSourceTrigger=PropertyChanged}" Margin="4,0,0,0"/>
            </Grid>

            <!-- 错误消息 -->
            <TextBlock Grid.Row="8" Text="{Binding ErrorMessage}" Foreground="#EF4444"
                       Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}"
                       Margin="0,0,0,8" TextWrapping="Wrap"/>

            <!-- 占位 -->
            <Border Grid.Row="9"/>

            <!-- 按钮 -->
            <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="取消" Command="{Binding CancelCommand}"/>
                <Button Content="生成配置" Command="{Binding ConfirmCommand}"
                        Background="{DynamicResource InfoBgBrush}" Foreground="{DynamicResource InfoBrush}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
