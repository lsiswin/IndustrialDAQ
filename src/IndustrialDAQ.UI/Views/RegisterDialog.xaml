<UserControl x:Class="IndustrialDAQ.UI.Views.RegisterDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" Width="420" Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="13,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource InfoBrush}"/></Style>
        <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="Margin" Value="4,12,0,5"/><Setter Property="FontSize" Value="13"/></Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="700"><Border Padding="28" CornerRadius="16" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"><StackPanel>
        <Button Content="✕" Width="32" Height="32" HorizontalAlignment="Right" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" ToolTip="关闭"/>
        <TextBlock Text="创建账号" FontSize="24" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/><TextBlock Text="注册 IndustrialDAQ 身份" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,5,0,24"/>
        <TextBlock Text="用户名" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="显示名称" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding RealName, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="密码" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="确认密码" Style="{StaticResource Label}"/><TextBox Style="{StaticResource Input}" Text="{Binding ConfirmPassword, UpdateSourceTrigger=PropertyChanged}"/>
        <TextBlock Text="账号身份" Style="{StaticResource Label}"/><ComboBox Height="44" IsEnabled="False" Foreground="{DynamicResource TextPrimaryBrush}" Background="{DynamicResource BrushBgTertiary}" ItemsSource="{Binding RegisterRoles}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedRole}"/><TextBlock Text="新账号默认为只读访客；工程师和管理员权限必须由管理员授权。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="4,7,0,0"/>
        <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/><Button Content="注册账号  ✓" Command="{Binding RegisterCommand}" Height="46" FontWeight="Medium" Margin="0,18,0,0"/><Button Content="已有账号？返回登录" Command="{Binding BackToLoginCommand}" Height="36" Margin="0,6,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InfoBrush}"/>
    </StackPanel></Border></ScrollViewer>
</UserControl>
