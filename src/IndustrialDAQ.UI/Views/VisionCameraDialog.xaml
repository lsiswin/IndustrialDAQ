<UserControl x:Class="IndustrialDAQ.UI.Views.VisionCameraDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="700" Height="520" Background="Transparent"
             Foreground="{DynamicResource TextPrimaryBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
        <Style x:Key="CameraInput" TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondaryBrush}"/>
        </Style>
        <Style x:Key="CameraCombo" TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource BrushBgSecondary}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSecondaryBrush}"/>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSecondaryBrush}"
            BorderThickness="1" CornerRadius="12" Padding="26">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid>
                <StackPanel>
                    <TextBlock Text="相机配置" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="统一维护相机连接；视觉任务只需选择这里保存的相机" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,18"/>
                </StackPanel>
                <Button Content="✕" Command="{Binding CancelCommand}" Width="34" Height="34"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent"
                        Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" FontSize="16" ToolTip="关闭"/>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource BrushBgSecondary}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="18">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="相机来源" Style="{StaticResource FieldLabel}"/>
                            <ComboBox Style="{StaticResource CameraCombo}" ItemsSource="{Binding CameraSources}"
                                      SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <TextBlock Text="相机名称" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource CameraInput}" Text="{Binding CameraName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding UsesDirectory, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="模拟图片目录" Style="{StaticResource FieldLabel}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Style="{StaticResource CameraInput}" Text="{Binding ImageDirectory}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="浏览目录" Command="{Binding BrowseCommand}" Padding="18,9" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,16,0,0" Visibility="{Binding UsesMvs, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="海康 MVS 相机" Style="{StaticResource FieldLabel}"/>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox Style="{StaticResource CameraCombo}" ItemsSource="{Binding DiscoveredCameras}"
                                      SelectedItem="{Binding SelectedDiscoveredCamera}" DisplayMemberPath="DisplayText"/>
                            <Button Grid.Column="1" Content="自动扫描" Command="{Binding ScanCommand}" Padding="18,9" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,16,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="帧间隔（毫秒）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Style="{StaticResource CameraInput}" Text="{Binding IntervalMilliseconds}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" Content="循环采集图片" IsChecked="{Binding Loop}"
                                  Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Bottom" Margin="16,0,0,12"/>
                    </Grid>

                    <Border Grid.Row="3" Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="12" Margin="0,16,0,0">
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="取消" Command="{Binding CancelCommand}" Padding="22,9" Margin="0,0,8,0"/>
                <Button Content="保存并连接" Command="{Binding SaveCommand}" Padding="22,9"
                        Background="{DynamicResource InfoBrush}" Foreground="White" BorderThickness="0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
