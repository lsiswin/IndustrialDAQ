<UserControl x:Class="IndustrialDAQ.UI.Views.VisionCameraDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="620" Height="560" Background="Transparent">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/></UserControl.Resources>
    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="24"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid><StackPanel><TextBlock Text="相机配置" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="相机可以独立运行实时预览，检测配方可稍后创建" Foreground="{DynamicResource TextMutedBrush}" Margin="0,5,0,18"/></StackPanel><Button Content="✕" Command="{Binding CancelCommand}" Width="32" Height="32" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"/></Grid>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
            <TextBlock Text="相机来源"/><ComboBox ItemsSource="{Binding CameraSources}" SelectedItem="{Binding SelectedSource}" DisplayMemberPath="DisplayName" Padding="8" Margin="0,5,0,12"/>
            <TextBlock Text="相机名称"/><TextBox Text="{Binding CameraName}" Padding="8" Margin="0,5,0,12"/>
            <StackPanel Visibility="{Binding UsesDirectory, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="模拟图片目录"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding ImageDirectory}" IsReadOnly="True" Padding="8"/><Button Grid.Column="1" Content="浏览" Command="{Binding BrowseCommand}" Padding="15,8" Margin="8,0,0,0"/></Grid></StackPanel>
            <StackPanel Visibility="{Binding UsesMvs, Converter={StaticResource BoolToVisibility}}"><TextBlock Text="海康 MVS 相机"/><Grid Margin="0,5,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DiscoveredCameras}" SelectedItem="{Binding SelectedDiscoveredCamera}" DisplayMemberPath="DisplayText" Padding="8"/><Button Grid.Column="1" Content="自动扫描" Command="{Binding ScanCommand}" Padding="15,8" Margin="8,0,0,0"/></Grid></StackPanel>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Margin="0,0,8,0"><TextBlock Text="帧间隔 ms"/><TextBox Text="{Binding IntervalMilliseconds}" Padding="8" Margin="0,5,0,0"/></StackPanel><CheckBox Grid.Column="1" Content="循环采集" IsChecked="{Binding Loop}" VerticalAlignment="Bottom" Margin="15,0,0,9"/></Grid>
            <Border Background="{DynamicResource BrushBgSecondary}" CornerRadius="5" Padding="12" Margin="0,18,0,0"><TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
        </StackPanel></ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button Content="取消" Command="{Binding CancelCommand}" Padding="20,8" Margin="0,0,8,0"/><Button Content="保存并连接" Command="{Binding SaveCommand}" Padding="20,8" Background="{DynamicResource InfoBrush}" Foreground="White" BorderThickness="0"/></StackPanel>
    </Grid></Border>
</UserControl>
