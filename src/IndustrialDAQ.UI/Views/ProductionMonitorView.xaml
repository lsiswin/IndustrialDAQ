<!-- File: ProductionMonitorView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.ProductionMonitorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
             xmlns:controls="clr-namespace:IndustrialDAQ.UI.Controls"
             xmlns:converters="clr-namespace:IndustrialDAQ.UI.Converters"
             xmlns:models="clr-namespace:IndustrialDAQ.UI.Models"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource BrushBgPrimary}">

    <UserControl.Resources>
        <converters:TreeArrowConverter x:Key="TreeArrowConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="DataGridActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 设备选择栏 -->
            <RowDefinition Height="Auto"/>   <!-- 报警栏 -->
            <RowDefinition Height="*"/>      <!-- 主内容区 -->
        </Grid.RowDefinitions>

        <!-- ═══════════ 设备选择栏 ═══════════ -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="4"
                Padding="10,8" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="选择设备:" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding Devices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="Name"
                          IsSynchronizedWithCurrentItem="True"
                          VerticalContentAlignment="Center"
                          Height="28"/>

                <!-- 设备详细信息展示 -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InfoBgBrush}" Padding="8,3" CornerRadius="4" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource InfoBrush}" BorderThickness="0.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="IP: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedDevice.IpAddress}" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource InfoBgBrush}" Padding="8,3" CornerRadius="4" Margin="0,0,12,0"
                            BorderBrush="{DynamicResource InfoBrush}" BorderThickness="0.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="端口: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedDevice.Port}" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource InfoBgBrush}" Padding="8,3" CornerRadius="4"
                            BorderBrush="{DynamicResource InfoBrush}" BorderThickness="0.5">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="类型: " Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding SelectedDevice.DriverType}" Foreground="{DynamicResource InfoBrush}" FontSize="12" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════ 报警栏 ═══════════ -->
        <Border Grid.Row="1"
                BorderThickness="1" CornerRadius="4"
                Padding="10,6" Margin="0,0,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="{DynamicResource SuccessBgBrush}"/>
                    <Setter Property="BorderBrush" Value="#065F46"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                            <Setter Property="Background" Value="{DynamicResource DangerBgBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock FontSize="16" VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="&#x2705;"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasAlarm}" Value="True">
                                    <Setter Property="Text" Value="&#x26A0;"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="1" Text="{Binding AlarmText}"
                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ═══════════ 主内容区：2 列布局 ═══════════ -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ────── 左列：仪表盘 ────── -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,6,0">
                <StackPanel>
                    <!-- 数字仪表 2x3 网格 -->
                    <Border Style="{DynamicResource PanelBorderStyle}">
                        <StackPanel>
                            <TextBlock Style="{DynamicResource PanelTitleStyle}"
                                       Text="实时仪表"/>
                            <ItemsControl ItemsSource="{Binding Gauges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:SemiCircleGauge
                                            Value="{Binding Value}"
                                            MinValue="{Binding MinValue}" MaxValue="{Binding MaxValue}"
                                            Unit="{Binding Unit}" Label="{Binding Label}"
                                            GaugeColor="{Binding GaugeColor}"
                                            Height="130" Margin="3"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- ────── 右列：实时数据表（趋势图已移至专用趋势监控页）────── -->
            <Border Grid.Column="1" Margin="6,0" Style="{DynamicResource PanelBorderStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Style="{DynamicResource PanelTitleStyle}"
                               Text="实时数据表"/>
                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding TagTable}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowStyle="{DynamicResource DataGridRowQualityStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="测点名称" Binding="{Binding TagName}"
                                                Width="180"/>
                            <DataGridTextColumn Header="描述" Binding="{Binding Description}"
                                                Width="180"/>
                            <DataGridTextColumn Header="当前值" Binding="{Binding Value}"
                                                Width="120"/>
                            <DataGridTextColumn Header="质量" Binding="{Binding Quality}"
                                                Width="80"/>
                            <DataGridTextColumn Header="时间戳" Binding="{Binding Timestamp}"
                                                Width="120"/>
                            <!-- 数据写入列 -->
                            <DataGridTemplateColumn Header="操作" Width="100" CanUserResize="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding CanWrite}" Value="True"/>
                                                                <Condition Binding="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=DataGrid}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Button Content="写入"
                                                    Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    VerticalAlignment="Center"
                                                    Style="{DynamicResource DataGridActionButtonStyle}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
