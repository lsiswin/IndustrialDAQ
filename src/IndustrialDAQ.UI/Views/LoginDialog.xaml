<UserControl x:Class="IndustrialDAQ.UI.Views.LoginDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:prism="http://prismlibrary.com/" prism:ViewModelLocator.AutoWireViewModel="True" Width="420" Background="Transparent">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BoolToVisibility"/><Style x:Key="Input" TargetType="TextBox"><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource InfoBrush}"/></Style><Style x:Key="PasswordInput" TargetType="PasswordBox"><Setter Property="Height" Value="48"/><Setter Property="Padding" Value="14,0"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="14"/><Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/><Setter Property="Background" Value="{DynamicResource BrushBgTertiary}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/></Style></UserControl.Resources>
    <Border Padding="32" CornerRadius="16" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Button HorizontalAlignment="Right" Content="✕" Width="32" Height="32" Command="{Binding CancelCommand}" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" ToolTip="关闭"/>
            <StackPanel Grid.Row="1" HorizontalAlignment="Center" Margin="0,4,0,28"><Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource BrushBgTertiary}"><TextBlock Text="⚡" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="IndustrialDAQ" FontSize="24" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,4"/><TextBlock Text="工业运行时身份与权限中心" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel>
            <StackPanel Grid.Row="2"><TextBlock Text="用户名" Margin="4,0,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox Style="{StaticResource Input}" Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"/><TextBlock Text="密码" Margin="4,18,0,6" Foreground="{DynamicResource TextSecondaryBrush}"/><PasswordBox Style="{StaticResource PasswordInput}" PasswordChanged="OnPasswordChanged"/><TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" Margin="0,12,0,0" Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"/></StackPanel>
            <StackPanel Grid.Row="3" Margin="0,26,0,0"><Button Content="登录并进入系统  →" Command="{Binding LoginCommand}" Height="48" FontWeight="Medium"/><Button Content="还没有账号？创建账号" Command="{Binding ShowRegisterCommand}" Height="38" Margin="0,10,0,0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource InfoBrush}"/></StackPanel>
        </Grid>
    </Border>
</UserControl>
