<!-- File: DeviceDetailView.xaml  Module: UI (Views)  Author: IndustrialDAQ Team -->
<UserControl x:Class="IndustrialDAQ.UI.Views.DeviceDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:models="clr-namespace:IndustrialDAQ.UI.Models"
             xmlns:vmodels="clr-namespace:IndustrialDAQ.UI.ViewModels"
             prism:ViewModelLocator.AutoWireViewModel="True"
             Background="{DynamicResource MainBgBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        
        <Style x:Key="DataGridActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InfoBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoBgBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="10" Grid.IsSharedSizeScope="True">
        <Border Style="{DynamicResource PanelBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- 内嵌表头 -->
                    <RowDefinition Height="*"/>    <!-- 数据列表 -->
                </Grid.RowDefinitions>

                <!-- 优化后的对齐表头 (支持主题) -->
                <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" Padding="0,12,0,12" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/> <!-- 展开按钮(19) + 缩进(19) -->
                            <ColumnDefinition Width="260" SharedSizeGroup="ColName"/>
                            <ColumnDefinition Width="120" SharedSizeGroup="ColValue"/>
                            <ColumnDefinition Width="100" SharedSizeGroup="ColQuality"/>
                            <ColumnDefinition Width="160" SharedSizeGroup="ColTime"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="测点名称 / 标识符" Grid.Column="1" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                        <TextBlock Text="当前实时值" Grid.Column="2" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="数据状态" Grid.Column="3" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="最后更新时间" Grid.Column="4" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                        <TextBlock Text="操作交互" Grid.Column="5" FontWeight="ExtraBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <TreeView Grid.Row="1" ItemsSource="{Binding TreeRoots}"
                          Background="Transparent" BorderThickness="0"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling">
                    <TreeView.Resources>
                        <!-- 文件夹/设备节点 -->
                        <HierarchicalDataTemplate DataType="{x:Type vmodels:ResourceTreeNodeItem}" ItemsSource="{Binding Children}">
                            <Grid Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ColName"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Grid.Column="0">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,10,0" VerticalAlignment="Center" FontSize="16" Foreground="{Binding IconColor}"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="ExtraBold" 
                                               Foreground="{DynamicResource InfoBrush}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding NodeId, StringFormat=' ({0})'}" FontSize="11" 
                                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </HierarchicalDataTemplate>

                        <!-- 测点项：全列对齐 -->
                        <DataTemplate DataType="{x:Type models:TagDisplayItem}">
                            <Grid Height="40">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition SharedSizeGroup="ColName"/>
                                    <ColumnDefinition SharedSizeGroup="ColValue"/>
                                    <ColumnDefinition SharedSizeGroup="ColQuality"/>
                                    <ColumnDefinition SharedSizeGroup="ColTime"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🔹" Margin="0,0,10,0" FontSize="12" VerticalAlignment="Center" Foreground="#38BDF8"/>
                                    <TextBlock Text="{Binding TagName}" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="14"/>
                                </StackPanel>

                                <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="#059669" 
                                           VerticalAlignment="Center" FontWeight="Bold" FontFamily="Consolas" FontSize="15"
                                           HorizontalAlignment="Center"/>
                                
                                <Border Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="8,2" CornerRadius="4">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1510B981"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                                    <Setter Property="Background" Value="#15EF4444"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Quality}" Value="Init">
                                                    <Setter Property="Background" Value="#1594A3B8"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Quality}" FontSize="12" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#059669"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Quality}" Value="Bad">
                                                        <Setter Property="Foreground" Value="#DC2626"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Quality}" Value="Init">
                                                        <Setter Property="Foreground" Value="#64748B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>

                                <TextBlock Grid.Column="3" Text="{Binding Timestamp}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                           FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                <Button Grid.Column="4" Content="指令写入" Command="{Binding DataContext.WriteTagCommand, RelativeSource={RelativeSource AncestorType=TreeView}}" 
                                        CommandParameter="{Binding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Height="26" Padding="12,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DataGridActionButtonStyle}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding CanWrite}" Value="True"/>
                                                        <Condition Binding="{Binding DataContext.CanModify, RelativeSource={RelativeSource AncestorType=TreeView}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </TreeView.Resources>
                    
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <!-- Try to bind IsExpanded to the ViewModel, fallback to True for root items if needed, but we handle it in VM -->
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TreeViewItem">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition />
                                            </Grid.RowDefinitions>
                                            <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="true">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="19" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ToggleButton x:Name="Expander" ClickMode="Press" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}">
                                                        <ToggleButton.Style>
                                                            <Style TargetType="ToggleButton">
                                                                <Setter Property="UIElement.Focusable" Value="false" />
                                                                <Setter Property="FrameworkElement.Width" Value="16" />
                                                                <Setter Property="FrameworkElement.Height" Value="16" />
                                                                <Setter Property="Control.Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                            <Border Width="16" Height="16" Background="Transparent">
                                                                                <Path Name="Arrow" Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                                    <Path.RenderTransform>
                                                                                        <RotateTransform Angle="0" CenterX="2" CenterY="4" />
                                                                                    </Path.RenderTransform>
                                                                                </Path>
                                                                            </Border>
                                                                            <ControlTemplate.Triggers>
                                                                                <Trigger Property="ToggleButton.IsChecked" Value="true">
                                                                                    <Setter TargetName="Arrow" Property="UIElement.RenderTransform">
                                                                                        <Setter.Value>
                                                                                            <RotateTransform Angle="90" CenterX="2" CenterY="4" />
                                                                                        </Setter.Value>
                                                                                    </Setter>
                                                                                </Trigger>
                                                                            </ControlTemplate.Triggers>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </ToggleButton.Style>
                                                    </ToggleButton>
                                                    <ContentPresenter x:Name="PART_Header" Grid.Column="1" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Grid>
                                            </Border>
                                            <ItemsPresenter Name="ItemsHost" Grid.Row="1" Margin="19,0,0,0"/>
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="HasItems" Value="false">
                                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                            </Trigger>
                                            <Trigger Property="IsExpanded" Value="false">
                                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="true">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectionBgBrush}" />
                                                <Setter Property="Foreground" Value="{DynamicResource InfoBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" SourceName="Bd" Value="true">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBgBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.ItemContainerStyle>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</UserControl>
